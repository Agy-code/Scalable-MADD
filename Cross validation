
cross_validation <- function(trainX, 
                             trainY,
                             Dtrain,
                             k_choices,
                             folds = 5, 
                             knn = 1,
                             D_RFF = 500,
                             method = "Deterministic",
                             n_tolerance = 2000) {
  trainX <- as.matrix(trainX)
  trainY <- as.vector(trainY)
  Dtrain <- as.matrix(Dtrain)

  n <- nrow(trainX)
  classes <- sort(unique(trainY))
  class_chr <- as.character(classes)
  J <- length(classes)

  vector_case <- is.null(dim(k_choices))

  if (vector_case) {
    k_base <- sort(unique(pmax(1L, as.integer(k_choices))))
    k_mat <- matrix(rep(k_base, times = J), nrow = length(k_base), ncol = J)
    colnames(k_mat) <- class_chr
  } else {
    k_mat <- as.matrix(k_choices)
    storage.mode(k_mat) <- "integer"

    if (ncol(k_mat) != J) {
      stop("If k_choices is a matrix/data.frame, it must have one column per class.")
    }

    if (is.null(colnames(k_mat))) {
      colnames(k_mat) <- class_chr
    } else {
      if (!all(class_chr %in% colnames(k_mat))) {
        stop("Column names of k_choices must match class labels.")
      }
      k_mat <- k_mat[, class_chr, drop = FALSE]
    }

    k_mat <- apply(k_mat, 2, function(x) pmax(1L, as.integer(x)))
    if (is.vector(k_mat)) {
      k_mat <- matrix(k_mat, ncol = J)
      colnames(k_mat) <- class_chr
    }
  }

  kmax_req <- apply(k_mat, 2, max)

  format_k <- function(k_row){
    if (vector_case) {
      as.integer(k_row[1L])
    } else {
      paste0("(", paste(k_row, collapse = ","), ")")
    }
  }

  knn_predict_block <- function(dist_block, labels, k = 1L) {
    labels <- as.vector(labels)

    if (k == 1L) {
      return(labels[max.col(-dist_block, ties.method = "first")])
    }

    labs_chr <- as.character(labels)
    out <- character(nrow(dist_block))

    for (i in seq_len(nrow(dist_block))) {
      idx <- order(dist_block[i, ])[seq_len(k)]
      nn_labs <- labs_chr[idx]
      tab <- table(nn_labs)
      out[i] <- names(tab)[which.max(tab)]
    }
    out
  }

  folds_id <- caret::createFolds(trainY, k = folds, returnTrain = FALSE)

  results <- vector("list", folds * nrow(k_mat))
  res_id <- 0L

  for (f in seq_along(folds_id)) {
    te <- folds_id[[f]]
    tr <- setdiff(seq_len(n), te)

    n_train <- length(tr)
    n_test  <- length(te)

    trainY_f <- trainY[tr]
    testY_f_chr <- as.character(trainY[te])

    Dtrain_f       <- Dtrain[tr, tr, drop = FALSE]
    D_test_train_f <- Dtrain[te, tr, drop = FALSE]

    class_counts_f <- tabulate(match(trainY_f, classes), nbins = J)
    names(class_counts_f) <- class_chr

    kmax_fold_req <- pmin(kmax_req, class_counts_f)
    names(kmax_fold_req) <- class_chr

    dpp_ids <- dpp_index(
      trainX = trainX[tr, , drop = FALSE],
      trainY = trainY_f,
      Dtrain = Dtrain_f,
      D_RFF = D_RFF,
      n_tolerance = n_tolerance,
      k = kmax_fold_req,
      sample_method = method,
      output = "list"
    )

    avail_len <- vapply(class_chr, function(cl) length(dpp_ids[[cl]]), integer(1L))

    feasible <- rep(TRUE, nrow(k_mat))
    for (j in seq_len(J)) {
      feasible <- feasible & (k_mat[, j] <= avail_len[j])
    }

    if (!any(feasible)) next

    k_use <- k_mat[feasible, , drop = FALSE]
    n_candidates <- nrow(k_use)

    add_list <- vector("list", n_candidates)

    k_prev <- rep(0L, J)
    for (tt in seq_len(n_candidates)) {
      k_cur <- k_use[tt, ]
      new_ids_tt <- integer(0)

      for (j in seq_len(J)) {
        if (k_cur[j] > k_prev[j]) {
          new_ids_tt <- c(new_ids_tt,
                          dpp_ids[[class_chr[j]]][(k_prev[j] + 1L):k_cur[j]])
        }
      }
      add_list[[tt]] <- unique(as.integer(new_ids_tt))
      k_prev <- k_cur
    }

    S_sum <- matrix(0, nrow = n_test, ncol = n_train)
    T_added <- 0
    is_included <- integer(n_train)
    MADD_mean <- matrix(0, nrow = n_test, ncol = n_train)

    for (tt in seq_len(n_candidates)) {
      new_ids <- add_list[[tt]]

      if (length(new_ids) > 0L) {
        dzx_mat <- D_test_train_f[, new_ids, drop = FALSE]
        dxx_mat <- Dtrain_f[, new_ids, drop = FALSE]
        m_new <- length(new_ids)

        for (jj in seq_len(m_new)) {
          S_sum <- S_sum + abs(outer(dzx_mat[, jj], dxx_mat[, jj], "-"))
        }

        T_added <- T_added + m_new

        for (jref in new_ids) {
            S_sum[, jref] <- S_sum[, jref] -
                             abs(D_test_train_f[, jref] - Dtrain_f[jref, jref])

            is_included[jref] <- 1L
                                }      
                 }

      denom <- pmax.int(1L, T_added - is_included)
      MADD_mean[] <- S_sum / rep(denom, each = n_test)

      pred_mean <- knn_predict_block(MADD_mean, trainY_f, k = knn)
      acc <- mean(as.character(pred_mean) == testY_f_chr)

      res_id <- res_id + 1L
      results[[res_id]] <- data.frame(
        fold = f,
        k_per_class = format_k(k_use[tt, ]),
        accuracy = acc,
        stringsAsFactors = FALSE
      )
    }
  }

  if (res_id == 0L) {
    return(data.frame(
      fold = integer(0),
      k_per_class = character(0),
      accuracy = numeric(0),
      stringsAsFactors = FALSE
    ))
  }

  out <- do.call(rbind, results[seq_len(res_id)])
  rownames(out) <- NULL
  out
}
