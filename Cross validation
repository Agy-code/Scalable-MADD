
cross_validation <- function(trainX,
                             trainY,
                             Dtrain,
                             k_choices,
                             folds = 5,
                             knn = 1L,
                             D_RFF = 500L,
                             sample_method ="deterministic",
                             n_tol = 2000L) {

  sample_method <- match.arg(sample_method)

  trainX <- as.matrix(trainX)
  trainY <- as.vector(trainY)
  Dtrain <- as.matrix(Dtrain)

  n <- nrow(trainX)
  class_labels <- sort(unique(trainY))
  class_names <- as.character(class_labels)
  n_classes <- length(class_labels)

  # -----------------------------------------------------------------------
  # Interpret candidate k values
  # -----------------------------------------------------------------------
  shared_k_vector <- is.null(dim(k_choices))

  if (shared_k_vector) {
    k_base <- sort(unique(pmax(1L, as.integer(k_choices))))
    k_grid <- matrix(rep(k_base, times = n_classes),
                     nrow = length(k_base),
                     ncol = n_classes)
    colnames(k_grid) <- class_names
  } else {
    k_grid <- as.matrix(k_choices)
    storage.mode(k_grid) <- "integer"

    if (ncol(k_grid) != n_classes) {
      stop("If k_choices is a matrix/data.frame, it must have one column per class.")
    }

    if (is.null(colnames(k_grid))) {
      colnames(k_grid) <- class_names
    } else {
      if (!all(class_names %in% colnames(k_grid))) {
        stop("Column names of k_choices must match class labels.")
      }
      k_grid <- k_grid[, class_names, drop = FALSE]
    }

    k_grid <- apply(k_grid, 2, function(x) pmax(1L, as.integer(x)))

    if (is.vector(k_grid)) {
      k_grid <- matrix(k_grid, ncol = n_classes)
      colnames(k_grid) <- class_names
    }
  }

  max_k_requested <- apply(k_grid, 2, max)

  format_k_choice <- function(k_row) {
    if (shared_k_vector) {
      as.integer(k_row[1L])
    } else {
      paste0("(", paste(k_row, collapse = ","), ")")
    }
  }

  # -----------------------------------------------------------------------
  # k-NN prediction from a test-to-training distance block
  # -----------------------------------------------------------------------
  knn_predict_block <- function(dist_block, labels, k = 1L) {
    labels <- as.vector(labels)

    if (k == 1L) {
      return(labels[max.col(-dist_block, ties.method = "first")])
    }

    labels_chr <- as.character(labels)
    predictions <- character(nrow(dist_block))

    for (i in seq_len(nrow(dist_block))) {
      nn_index <- sort.int(dist_block[i, ],
                           partial = seq_len(k),
                           index.return = TRUE)$ix[seq_len(k)]
      nn_labels <- labels_chr[nn_index]
      label_counts <- table(nn_labels)
      predictions[i] <- names(label_counts)[which.max(label_counts)]
    }

    predictions
  }

  # -----------------------------------------------------------------------
  # Stratified folds
  # -----------------------------------------------------------------------
  fold_indices <- caret::createFolds(trainY, k = folds, returnTrain = FALSE)

  results <- vector("list", length = folds * nrow(k_grid))
  result_counter <- 0L

  # -----------------------------------------------------------------------
  # CV loop
  # -----------------------------------------------------------------------
  for (fold_id in seq_along(fold_indices)) {
    test_idx  <- fold_indices[[fold_id]]
    train_idx <- setdiff(seq_len(n), test_idx)

    n_train_fold <- length(train_idx)
    n_test_fold  <- length(test_idx)

    X_train_fold <- trainX[train_idx, , drop = FALSE]
    y_train_fold <- trainY[train_idx]
    y_test_fold  <- as.character(trainY[test_idx])

    D_train_fold      <- Dtrain[train_idx, train_idx, drop = FALSE]
    D_test_train_fold <- Dtrain[test_idx, train_idx, drop = FALSE]

    class_counts_fold <- tabulate(match(y_train_fold, class_labels),
                                  nbins = n_classes)
    names(class_counts_fold) <- class_names

    max_k_fold <- pmin(max_k_requested, class_counts_fold)
    names(max_k_fold) <- class_names

    ref_index_list <- dpp_index(
      trainX = X_train_fold,
      trainY = y_train_fold,
      Dtrain = D_train_fold,
      D_RFF = D_RFF,
      n_tol = n_tol,
      k = max_k_fold,
      sample_method = sample_method,
      output = "list"
    )

    available_per_class <- vapply(class_names,
                                  function(cl) length(ref_index_list[[cl]]),
                                  integer(1L))

    feasible_rows <- rep(TRUE, nrow(k_grid))
    for (j in seq_len(n_classes)) {
      feasible_rows <- feasible_rows & (k_grid[, j] <= available_per_class[j])
    }

    if (!any(feasible_rows)) {
      next
    }

    feasible_k_grid <- k_grid[feasible_rows, , drop = FALSE]
    n_candidates <- nrow(feasible_k_grid)

    # ---------------------------------------------------------------------
    # Identify newly added references as k increases
    # ---------------------------------------------------------------------
    newly_added_refs <- vector("list", n_candidates)
    previous_k <- rep(0L, n_classes)

    for (candidate_id in seq_len(n_candidates)) {
      current_k <- feasible_k_grid[candidate_id, ]
      new_ids <- integer(0)

      for (j in seq_len(n_classes)) {
        if (current_k[j] > previous_k[j]) {
          new_ids <- c(
            new_ids,
            ref_index_list[[class_names[j]]][(previous_k[j] + 1L):current_k[j]]
          )
        }
      }

      newly_added_refs[[candidate_id]] <- unique(as.integer(new_ids))
      previous_k <- current_k
    }

    # ---------------------------------------------------------------------
    # Incremental scalable MADD computation
    # ---------------------------------------------------------------------
    cumulative_abs_sum <- matrix(0, nrow = n_test_fold, ncol = n_train_fold)
    total_refs_used <- 0L
    is_reference_point <- integer(n_train_fold)

    madd_mean_block <- matrix(0, nrow = n_test_fold, ncol = n_train_fold)

    for (candidate_id in seq_len(n_candidates)) {
      new_ref_ids <- newly_added_refs[[candidate_id]]

      if (length(new_ref_ids) > 0L) {
        test_to_ref  <- D_test_train_fold[, new_ref_ids, drop = FALSE]
        train_to_ref <- D_train_fold[, new_ref_ids, drop = FALSE]
        n_new_refs   <- length(new_ref_ids)

        for (r in seq_len(n_new_refs)) {
          cumulative_abs_sum <-
            cumulative_abs_sum +
            abs(outer(test_to_ref[, r], train_to_ref[, r], "-"))
        }

        total_refs_used <- total_refs_used + n_new_refs

        for (ref_id in new_ref_ids) {
          cumulative_abs_sum[, ref_id] <-
            cumulative_abs_sum[, ref_id] -
            abs(D_test_train_fold[, ref_id] - D_train_fold[ref_id, ref_id])

          is_reference_point[ref_id] <- 1L
        }
      }

      denominator <- pmax.int(1L, total_refs_used - is_reference_point)
      madd_mean_block[] <- cumulative_abs_sum / rep(denominator, each = n_test_fold)

      predicted_labels <- knn_predict_block(madd_mean_block,
                                            y_train_fold,
                                            k = knn)

      fold_accuracy <- mean(as.character(predicted_labels) == y_test_fold)

      result_counter <- result_counter + 1L
      results[[result_counter]] <- data.frame(
        fold = fold_id,
        k_per_class = format_k_choice(feasible_k_grid[candidate_id, ]),
        accuracy = fold_accuracy,
        stringsAsFactors = FALSE
      )
    }
  }

  if (result_counter == 0L) {
    return(data.frame(
      fold = integer(0),
      k_per_class = character(0),
      accuracy = numeric(0),
      stringsAsFactors = FALSE
    ))
  }

  output <- do.call(rbind, results[seq_len(result_counter)])
  rownames(output) <- NULL
  output
}
