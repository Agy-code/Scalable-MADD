nn_madd <- function(trainX,
                    trainY,
                    testX,
                    testY = NULL,
                    Dtrain = NULL,
                    k = 1,
                    reference.ind = NULL,
                    memory.eff = "NO",
                    return_MADD = FALSE) {

  trainX <- as.matrix(trainX)
  testX  <- as.matrix(testX)
  trainY <- as.vector(trainY)

  if (!is.null(testY)) {
    testY <- as.vector(testY)
  }

  if (!memory.eff %in% c("NO", "YES")) {
    stop("memory.eff must be either 'NO' or 'YES'")
  }

  n <- nrow(trainX)
  m <- nrow(testX)
  d <- ncol(trainX)

  if (length(k) != 1L || !is.finite(k) ||
      k < 1L || k != as.integer(k) || k > n) {
    stop("k must be a positive integer not exceeding the training sample size.")
  }

  k <- as.integer(k)

  if (!is.null(reference.ind)) {

    reference.ind <- as.integer(reference.ind)

    if (length(reference.ind) < 2L) {
      stop("Need at least 2 reference points.")
    }

    if (any(reference.ind < 1L) || any(reference.ind > n)) {
      stop("reference.ind contains invalid training indices.")
    }
  }

  have_test_labels <- !is.null(testY)

  distance_to_point <- function(A, x) {
    sqrt(
      rowSums(
        (A - matrix(
          x,
          nrow = nrow(A),
          ncol = ncol(A),
          byrow = TRUE
        ))^2
      )
    )
  }

  # -----------------------------------------------------------------------
  # Case 1: No reference point is supplied.
  # -----------------------------------------------------------------------
  if (is.null(reference.ind)) {

    if (memory.eff == "NO") {

      if (is.null(Dtrain)) {
        Dtrain <- as.matrix(Rfast::Dist(trainX))
      } else {
        Dtrain <- as.matrix(Dtrain)
      }

      if (return_MADD) {
        MADD_mat <- matrix(0, nrow = m, ncol = n)
      }

      preds <- character(m)

      for (t in seq_len(m)) {

        z <- testX[t, ]
        d_z <- distance_to_point(trainX, z)

        diff_mat <- abs(sweep(Dtrain, 2, d_z, "-"))
        madd_row <- (rowSums(diff_mat) - diag(diff_mat)) / (n - 1)

        nn <- order(madd_row)[seq_len(k)]
        preds[t] <- names(which.max(table(trainY[nn])))

        if (return_MADD) {
          MADD_mat[t, ] <- madd_row
        }
      }

    } else {

      if (return_MADD) {
        MADD_mat <- matrix(0, nrow = m, ncol = n)
      }

      preds <- character(m)

      for (t in seq_len(m)) {

        z <- testX[t, ]
        d_z <- distance_to_point(trainX, z)

        madd_row <- numeric(n)

        for (i in seq_len(n)) {
          d_i <- distance_to_point(trainX, trainX[i, ])
          madd_row[i] <- mean(abs(d_z[-i] - d_i[-i]))
        }

        nn <- order(madd_row)[seq_len(k)]
        preds[t] <- names(which.max(table(trainY[nn])))

        if (return_MADD) {
          MADD_mat[t, ] <- madd_row
        }
      }
    }

  # -----------------------------------------------------------------------
  # Case 2: Reference points are supplied.
  # -----------------------------------------------------------------------
  } else {

    P <- length(reference.ind)
    refX <- trainX[reference.ind, , drop = FALSE]

    if (!is.null(Dtrain)) {

      Dtrain <- as.matrix(Dtrain)
      D_tr_ref <- Dtrain[, reference.ind, drop = FALSE]

    } else {

      D_tr_ref <- matrix(0, nrow = n, ncol = P)

      for (p in seq_len(P)) {
        D_tr_ref[, p] <- distance_to_point(trainX, refX[p, ])
      }
    }

    ref.position <- match(seq_len(n), reference.ind, nomatch = 0L)
    is.reference <- ref.position > 0L

    if (return_MADD) {
      MADD_mat <- matrix(0, nrow = m, ncol = n)
    }

    preds <- character(m)

    for (t in seq_len(m)) {

      z <- testX[t, ]
      d_z_ref <- distance_to_point(refX, z)

      diff_mat <- abs(sweep(D_tr_ref, 2, d_z_ref, "-"))
      madd_row <- rowMeans(diff_mat)

      if (any(is.reference)) {

        idx <- which(is.reference)
        col_idx <- ref.position[idx]

        adjusted_sum <-
          rowSums(diff_mat[idx, , drop = FALSE]) -
          diff_mat[cbind(idx, col_idx)]

        madd_row[idx] <- adjusted_sum / (P - 1)
      }

      nn <- order(madd_row)[seq_len(k)]
      preds[t] <- names(which.max(table(trainY[nn])))

      if (return_MADD) {
        MADD_mat[t, ] <- madd_row
      }
    }
  }

  conf <- NULL
  acc  <- NULL

  if (have_test_labels) {
    conf <- table(prediction = preds, truth = testY)
    acc  <- mean(as.character(preds) == as.character(testY))
  }

  list(
    MADD = if (return_MADD) MADD_mat else NULL,
    prediction = preds,
    conf.matrix = conf,
    accuracy = acc
  )
}
