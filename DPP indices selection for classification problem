
# -------------------------------------------------------------------------
# DPP sample selection of reference points for classification
# - For each class, this function selects k_j representative observations
#    using a DPP-based sampling scheme. The selected observations are then
#    pooled to form the final set of reference points.
#
# The number of representatives in each class is k:
#   - a single value: same number of samples are drawn for all classes
#   - a vector: one value per class (in sorted class order)
#   - a named vector: matched to class labels
#
# For moderate class sizes, an exact DPP is used.
# For large classes (n_cl > n_tol), an approximate DPP based on Random
# Fourier features is used.
# -------------------------------------------------------------------------

dpp_index <- function(trainY, Dtrain = NULL,
                      k,
                      sample_method = "kDPP",
                      trainX = NULL,
                      D_RFF = 500L,
                      n_tol = 4000L,
                      output = "vector")
{
  trainY <- as.vector(trainY)
  classes <- sort(unique(trainY))

  if (missing(k)) {
    stop("k must be provided.")
  }

  if (any(table(trainY) <= 1L)) {
    stop("Each class must contain at least two observations.")
  }

  if (!output %in% c("vector", "list")) {
    stop("output must be either 'vector' or 'list'.")
  }

  # -----------------------------------------------------------------------
  # Validation and interpretation of k
  # -----------------------------------------------------------------------
  if (any(!is.finite(k))) {
    stop("All values of k must be finite.")
  }

  if (any(k < 0) || any(k != as.integer(k))) {
    stop("All values of k must be non-negative integers.")
  }

  k <- as.integer(k)

  if (length(k) == 1L) {
    k_type <- "scalar"

  } else if (!is.null(names(k))) {
    missing_classes <- setdiff(as.character(classes), names(k))
    if (length(missing_classes) > 0L) {
      stop("k is a named vector but is missing class(es): ",
           paste(missing_classes, collapse = ", "))
    }
    k_type <- "named"

  } else {
    if (length(k) != length(classes)) {
      stop("k must have length 1 or match the number of classes (",
           length(classes), ").")
    }
    k_type <- "vector"
  }

  if (length(n_tol) != 1L || !is.finite(n_tol) || n_tol < 1 || n_tol != as.integer(n_tol)) {
    stop("'n_tol' must be a positive integer.")
  }
  n_tol <- as.integer(n_tol)

  # -----------------------------------------------------------------------
  # Random Fourier feature map (used only for large classes)
  # -----------------------------------------------------------------------
  RFF <- function(X, D, sigma) {
    X <- as.matrix(X)
    d <- ncol(X)

    W <- matrix(rnorm(D * d, sd = 1 / sigma), nrow = D)
    projected_X <- X %*% t(W)

    if (D > 500L) {
      phase_shift <- runif(D, 0, 2 * pi)
      Z <- sqrt(2 / D) * cos(sweep(projected_X, 2, phase_shift, "+"))
    } else {
      Z <- cbind(cos(projected_X), sin(projected_X)) / sqrt(D)
    }

    Z
  }

  all_ids <- integer(0)
  class_ids <- vector("list", length(classes))
  names(class_ids) <- as.character(classes)

  for (cl in classes) {
    idx_cl <- which(trainY == cl)
    n_cl <- length(idx_cl)

    # ---------------------------------------------------------------------
    # Determine k for this class
    # ---------------------------------------------------------------------
    if (k_type == "scalar") {
      k_cl <- min(k, n_cl)

    } else if (k_type == "vector") {
      k_cl <- min(k[match(cl, classes)], n_cl)

    } else {
      k_cl <- min(k[as.character(cl)], n_cl)
    }

    k_cl <- max(1L, as.integer(k_cl))

    # ---------------------------------------------------------------------
    # Exact DPP for moderate class sizes
    # ---------------------------------------------------------------------
    if (n_cl <= n_tol) {

      if (!is.null(Dtrain)) {
        Dcl <- as.matrix(Dtrain)[idx_cl, idx_cl, drop = FALSE]

      } else {
        if (is.null(trainX)) {
          stop("Either Dtrain or trainX must be provided.")
        }
        train_cl <- as.matrix(trainX)[idx_cl, , drop = FALSE]
        Dcl <- as.matrix(dist(train_cl))
      }

      sigma <- median(Dcl[upper.tri(Dcl)])

      if (!is.finite(sigma) || sigma <= 0) {
        sigma <- median(Dcl[Dcl > 0])
        if (!is.finite(sigma) || sigma <= 0) sigma <- 1
      }

      Lcl <- exp(-(Dcl^2) / (2 * sigma^2))
      eig <- eigen(Lcl, symmetric = TRUE)

      sampled_local <- sample_DPP(eig, method = sample_method, k = k_cl)

    } else {

      # -------------------------------------------------------------------
      # RFF-based approximate DPP for large classes
      # -------------------------------------------------------------------
      if (is.null(trainX)) {
        stop("trainX must be provided for RFF approximation.")
      }

      train_cl <- as.matrix(trainX)[idx_cl, , drop = FALSE]

      if (!is.null(Dtrain)) {
        Dcl <- as.matrix(Dtrain)[idx_cl, idx_cl, drop = FALSE]
        sigma <- median(Dcl[upper.tri(Dcl)])
      } else {
        samp <- sample(n_cl, min(2000L, n_cl))
        D_samp <- as.matrix(dist(train_cl[samp, , drop = FALSE]))
        sigma <- median(D_samp[upper.tri(D_samp)])
      }

      if (!is.finite(sigma) || sigma <= 0) sigma <- 1

      Z <- RFF(train_cl, D_RFF, sigma)
      C <- crossprod(Z)

      eigC <- eigen(C, symmetric = TRUE)
      keep <- eigC$values > 1e-10

      vals <- eigC$values[keep]
      V_feat <- eigC$vectors[, keep, drop = FALSE]

      U <- Z %*% V_feat
      norms <- sqrt(colSums(U^2))
      norms[norms == 0] <- 1
      U <- sweep(U, 2, norms, "/")

      eig <- list(values = vals, vectors = U)
      r_eff <- sum(vals > 1e-10)

      if (r_eff <= 0L) {
        sampled_local <- sample.int(n_cl, 1L)
      } else {
        if (k_cl > r_eff) k_cl <- r_eff
        sampled_local <- sample_DPP(eig, method = sample_method, k = k_cl)
      }
    }

    sampled_global <- idx_cl[sampled_local]

    all_ids <- c(all_ids, sampled_global)
    class_ids[[as.character(cl)]] <- sampled_global
  }

  if (output == "vector") {
    unique(all_ids)
  } else {
    class_ids
  }
}





# -------------------------------------------------------------------------
# Estimate the effective rank within each class
#
# This function computes, for each class, the effective rank of the
# random-Fourier-feature approximation used in the DPP construction.
# The resulting value can be used as an upper bound on the number of
# representative observations that can be meaningfully selected from
# that class under the approximate DPP model.
#
# If a full training distance matrix is available, it is used to estimate
# the bandwidth parameter within each class. Otherwise, the bandwidth is
# estimated from a subsample of observations in that class.
# -------------------------------------------------------------------------

find_reff <- function(trainX, trainY,
                      Dtrain = NULL,
                      D_RFF = 500L,
                      tol = 1e-10) {

  trainX <- as.matrix(trainX)
  trainY <- as.vector(trainY)
  classes <- sort(unique(trainY))

  if (nrow(trainX) != length(trainY)) {
    stop("The number of rows in trainX must match the length of trainY.")
  }

  if (length(D_RFF) != 1L || !is.finite(D_RFF) || D_RFF < 1 || D_RFF != as.integer(D_RFF)) {
    stop("'D_RFF' must be a positive integer.")
  }
  D_RFF <- as.integer(D_RFF)

  if (length(tol) != 1L || !is.finite(tol) || tol < 0) {
    stop("'tol' must be a non-negative number.")
  }

  # -----------------------------------------------------------------------
  # Random Fourier feature map used to approximate the within-class kernel.
  #
  # For larger values of D_RFF, a cosine feature map with random phase
  # shifts is used. For smaller values, paired cosine and sine features
  # are used instead.
  # -----------------------------------------------------------------------
  RFF <- function(X, D, sigma) {
    X <- as.matrix(X)
    d <- ncol(X)

    W <- matrix(rnorm(D * d, sd = 1 / sigma), nrow = D)
    projected_X <- X %*% t(W)

    if (D > 500L) {
      phase_shift <- runif(D, min = 0, max = 2 * pi)
      Z <- sqrt(2 / D) * cos(sweep(projected_X, 2, phase_shift, "+"))
    } else {
      Z <- cbind(cos(projected_X), sin(projected_X)) / sqrt(D)
    }

    Z
  }

  r_eff_vec <- numeric(length(classes))
  names(r_eff_vec) <- as.character(classes)

  for (cl in classes) {
    idx_cl <- which(trainY == cl)
    n_cl <- length(idx_cl)

    train_cl <- trainX[idx_cl, , drop = FALSE]

    # ---------------------------------------------------------------------
    # Estimate the bandwidth parameter within this class.
    # If Dtrain is available, reuse it. Otherwise, estimate the scale from
    # a subsample of observations in the class.
    # ---------------------------------------------------------------------
    if (!is.null(Dtrain)) {
      Dcl <- as.matrix(Dtrain)[idx_cl, idx_cl, drop = FALSE]
      sigma <- median(Dcl[upper.tri(Dcl)])
    } else {
      sampled_rows <- sample(n_cl, min(2000L, n_cl))
      D_samp <- as.matrix(dist(train_cl[sampled_rows, , drop = FALSE]))
      sigma <- median(D_samp[upper.tri(D_samp)])
    }

    if (!is.finite(sigma) || sigma <= 0) {
      if (!is.null(Dtrain)) {
        sigma <- median(Dcl[Dcl > 0])
      } else {
        sigma <- median(D_samp[D_samp > 0])
      }

      if (!is.finite(sigma) || sigma <= 0) {
        sigma <- 1
      }
    }

    # ---------------------------------------------------------------------
    # Build the random-Fourier-feature representation for this class and
    # use it to estimate the effective rank.
    # ---------------------------------------------------------------------
    Z <- RFF(X = train_cl, D = D_RFF, sigma = sigma)
    C <- crossprod(Z)

    eigC <- eigen(C, symmetric = TRUE)
    eigenvalues <- eigC$values

    r_eff <- sum(eigenvalues > tol)
    r_eff_vec[as.character(cl)] <- r_eff
  }

  return(r_eff_vec)
}

